<UserControl x:Class="NPTELManagement.Desktop.Views.AdminStaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:NPTELManagement.Desktop.Common"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <common:ActiveStatusTextConverter x:Key="ActiveStatusConverter"/>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Actions -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ADMINISTRATION MODULE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Staff &amp; Mentor Management" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='Total Faculty / Staff Members: {0}'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Add Staff" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCreateDialogCommand}" Margin="0,0,8,0" Padding="14,8"/>
                    <Button Content="✎ Edit" Style="{StaticResource SecondaryButton}" Command="{Binding OpenEditDialogCommand}" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Content="🔑 Reset Password" Style="{StaticResource SecondaryButton}" Command="{Binding OpenResetPasswordDialogCommand}" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Content="⏻ Toggle Status" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleStatusCommand}" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Padding="12,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Filters & Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="16,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Search (Name / Staff ID / Email)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Department" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DepartmentOptions}" SelectedItem="{Binding SelectedDepartment}" Width="110" Style="{StaticResource FormComboBox}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Assigned Year" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" Width="110" Style="{StaticResource FormComboBox}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Assigned Class" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClass}" Width="110" Style="{StaticResource FormComboBox}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Account Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="110" Style="{StaticResource FormComboBox}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 3. DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="{StaticResource ActionBrush}" VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <DataGrid ItemsSource="{Binding StaffMembers}" 
                          SelectedItem="{Binding SelectedStaff}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Staff ID" Binding="{Binding StaffIdentifier}" Width="140" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Faculty Name" Binding="{Binding StaffName}" Width="200" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Dept" Binding="{Binding Department}" Width="80"/>
                        <DataGridTextColumn Header="Year In-Charge" Binding="{Binding AssignedYear, StringFormat='Year {0}'}" Width="120"/>
                        <DataGridTextColumn Header="Class In-Charge" Binding="{Binding AssignedClass, TargetNullValue='All Classes'}" Width="120"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                        <DataGridTextColumn Header="Mentees" Binding="{Binding AssignedStudentCount}" Width="80"/>
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource ActiveStatusConverter}}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="4,8,0,0"/>

        <!-- 4. Create Staff Modal -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" CornerRadius="8" Padding="24" Effect="{StaticResource DropShadow}">
                <StackPanel>
                    <TextBlock Text="Provision New Staff / Faculty Account" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Faculty Full Name *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                    <TextBox Text="{Binding NewStaff.StaffName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Staff Identifier (e.g. CSE_STAFF_Y1) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding NewStaff.StaffIdentifier, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Department" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding NewStaff.Department, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                            <TextBlock Text="Assigned Year" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding NewStaff.AssignedYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="Class (optional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding NewStaff.AssignedClass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding NewStaff.Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Initial Password (Default: Staff@123)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding NewStaff.InitialPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCreateDialogCommand}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="Provision Staff" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCreateCommand}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 5. Edit Staff Modal -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsEditDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" CornerRadius="8" Padding="24" Effect="{StaticResource DropShadow}">
                <StackPanel>
                    <TextBlock Text="Edit Staff &amp; Scope Assignment" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Faculty Full Name *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                    <TextBox Text="{Binding EditStaff.StaffName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Department" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding EditStaff.Department, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                            <TextBlock Text="Assigned Year" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding EditStaff.AssignedYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="Class Scope" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding EditStaff.AssignedClass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding EditStaff.Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CloseEditDialogCommand}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="Save Changes" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitEditCommand}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 6. Reset Password Modal -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsResetPasswordDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" CornerRadius="8" Padding="24" Effect="{StaticResource DropShadow}">
                <StackPanel>
                    <TextBlock Text="Reset Faculty Password" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SelectedStaff.StaffName, StringFormat='Assigning new password for {0}:'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="New Password *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CloseResetPasswordDialogCommand}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="Confirm Reset" Style="{StaticResource DangerButton}" Command="{Binding SubmitResetPasswordCommand}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
