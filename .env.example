# ============================================================================
# NPTEL Management System - Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION PASSWORDS OR SECRETS TO REPOSITORY
# ============================================================================

# Supabase PostgreSQL Database Connection String
# Example: Host=db.xxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_SECURE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
SUPABASE_DB_CONNECTION=

# JWT Signing Secret (must be at least 32 characters long)
JWT_SECRET=

# Optional JWT settings
JWT_ISSUER=NPTELManagementApi
JWT_AUDIENCE=NPTELManagementClient

# Optional Supabase Storage Configuration (for future certificate storage)
STORAGE_CONFIG=
