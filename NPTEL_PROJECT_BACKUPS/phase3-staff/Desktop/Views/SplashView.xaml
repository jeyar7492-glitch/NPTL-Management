<UserControl x:Class="NPTELManagement.Desktop.Views.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:NPTELManagement.Desktop.Common"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Center Card -->
        <Border Style="{StaticResource CardStyle}"
                Width="540"
                Padding="40,48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                
                <!-- Institutional Header -->
                <TextBlock Text="JP COLLEGE OF ENGINEERING"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Text="NPTEL Management System"
                           FontFamily="Segoe UI"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="NPTEL Course Registration &amp; Certificate Management"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,32"/>

                <!-- Loading State -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource InvBoolToVis}}"
                            HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="{Binding IsLoading}"
                                 Height="4"
                                 Width="360"
                                 Foreground="{StaticResource ActionBrush}"
                                 Background="{StaticResource BorderBrush}"
                                 BorderThickness="0"
                                 Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Error State -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center">
                    
                    <Border Background="{StaticResource DangerLightBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,12"
                            Width="440"
                            Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Connection Failure"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="14"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Retry Connection"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RetryCommand}"
                                Width="160"
                                Margin="0,0,12,0"/>
                        <Button Content="Exit Application"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ExitCommand}"
                                Width="140"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
