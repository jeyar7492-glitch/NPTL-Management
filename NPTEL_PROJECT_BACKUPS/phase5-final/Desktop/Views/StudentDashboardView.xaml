<UserControl x:Class="NPTELManagement.Desktop.Views.StudentDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:NPTELManagement.Desktop.Common"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{StaticResource BackgroundBrush}"
             Loaded="StudentDashboardView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <common:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            
            <!-- Page Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="STUDENT DASHBOARD"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource SecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DisplayName, StringFormat='Welcome, {0}'}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Review your enrolled courses, exam progress, and verification status."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📚 My Courses"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToCoursesCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="🔔 Notifications"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding NavigateToNotificationsCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="↻ Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Foreground="{StaticResource ActionBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,0,16"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- Error Banner -->
            <Border Background="{StaticResource DangerLightBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="0,0,0,20"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Data Load Failure"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="14"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Retry"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshCommand}"
                            Padding="14,6"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Main Content Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.5*"/>
                    <ColumnDefinition Width="6.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Official Profile Card -->
                <Border Grid.Column="0" 
                        Style="{StaticResource CardStyle}" 
                        Margin="0,0,20,0"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Academic Profile"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,16"/>

                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Full Name" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Register Number" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DisplayRegisterNumber}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Department" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DisplayDepartment}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Year" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DisplayYear}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Class Section" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DisplayClassSection}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DisplayBatch}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="Contact Details" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Email Address" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding DisplayEmail}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Phone Number" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding DisplayPhone}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Right Column: Real Summary KPI Metrics & Actions -->
                <StackPanel Grid.Column="1">
                    
                    <TextBlock Text="Real-Time Course &amp; Certification Metrics"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <!-- KPI Cards (3 Columns x 2 Rows) -->
                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        
                        <!-- Registered Courses -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="REGISTERED"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding RegisteredCoursesCount}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           Margin="0,4,0,2"/>
                                <TextBlock Text="Courses registered"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- In Progress Courses -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="IN PROGRESS"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ActionBrush}"/>
                                <TextBlock Text="{Binding InProgressCoursesCount}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ActionBrush}"
                                           Margin="0,4,0,2"/>
                                <TextBlock Text="Active course learning"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Completed Courses -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="COMPLETED"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{Binding CompletedCoursesCount}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,4,0,2"/>
                                <TextBlock Text="Completed coursework"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Exam Pending -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="EXAM PENDING"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="{Binding ExamPendingCount}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,4,0,2"/>
                                <TextBlock Text="Upcoming exams"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Certificate Pending -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="CERTIFICATE PENDING"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#854D0E"/>
                                <TextBlock Text="{Binding CertificatePendingCount}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#B45309"
                                           Margin="0,4,0,2"/>
                                <TextBlock Text="Awaiting verification"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Certificate Verified -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="CERTIFICATE VERIFIED"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{Binding CertificateVerifiedCount}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,4,0,2"/>
                                <TextBlock Text="Verified &amp; approved"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- Fast Navigation Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="NPTEL Academic Workflow"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Manage your course registrations, view milestone timelines, examine hall tickets, and track certificates."
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="My NPTEL Courses" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="View course details, duration, start &amp; end dates, and complete 11-stage progress timelines." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        <Button Content="Go to My Courses →"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding NavigateToCoursesCommand}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Academic Notifications" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Stay updated with course release milestones, hall ticket downloads, and verification notices." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        <Button Content="View Notifications →"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding NavigateToNotificationsCommand}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
