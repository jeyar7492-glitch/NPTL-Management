<UserControl x:Class="NPTELManagement.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Border Style="{StaticResource CardStyle}"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="650">
            <StackPanel HorizontalAlignment="Center">
                
                <Border Background="#DBEAFE"
                        CornerRadius="24"
                        Width="48" Height="48"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <TextBlock Text="ℹ"
                               FontSize="22"
                               Foreground="{StaticResource ActionBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding Title}"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <Border Background="#FEF3C7"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <TextBlock Text="SCHEDULED FOR PHASE 2"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource WarningBrush}"/>
                </Border>

                <TextBlock Text="{Binding Description}"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           LineHeight="22"
                           Margin="0,0,0,8"/>

                <TextBlock Text="No fake mock data is displayed. Production integration will take place in the next phase."
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
