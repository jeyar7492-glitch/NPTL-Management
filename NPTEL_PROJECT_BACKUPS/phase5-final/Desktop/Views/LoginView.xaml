<UserControl x:Class="NPTELManagement.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:NPTELManagement.Desktop.Common"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <common:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Center Card -->
        <Border Style="{StaticResource CardStyle}"
                Width="480"
                Padding="36,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                
                <!-- Institutional Branding -->
                <TextBlock Text="JP COLLEGE OF ENGINEERING"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource SecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="NPTEL Management System"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Secure NPTEL Course Management"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Role Selector Tabs -->
                <Border Background="#F1F5F9"
                        CornerRadius="8"
                        Padding="4"
                        Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0"
                                     Content="Student"
                                     Style="{StaticResource RoleSegmentButton}"
                                     IsChecked="{Binding IsStudentRole, Mode=TwoWay}"/>
                        <RadioButton Grid.Column="1"
                                     Content="Staff"
                                     Style="{StaticResource RoleSegmentButton}"
                                     IsChecked="{Binding IsStaffRole, Mode=TwoWay}"/>
                        <RadioButton Grid.Column="2"
                                     Content="Admin"
                                     Style="{StaticResource RoleSegmentButton}"
                                     IsChecked="{Binding IsAdminRole, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- Error Banner -->
                <Border Background="{StaticResource DangerLightBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,18"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontWeight="Medium"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Identifier Field -->
                <TextBlock Text="{Binding IdentifierLabel}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TxtIdentifier"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnInputKeyDown"
                         Margin="0,0,0,16"/>

                <!-- Password Field -->
                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,24">
                    <!-- Masked Password -->
                    <PasswordBox x:Name="TxtPasswordMasked"
                                 Style="{StaticResource ModernPasswordBox}"
                                 PasswordChanged="TxtPasswordMasked_PasswordChanged"
                                 KeyDown="OnInputKeyDown"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvBoolToVis}}"
                                 Padding="12,10,40,10"/>

                    <!-- Plain Text Password (when visible) -->
                    <TextBox x:Name="TxtPasswordPlain"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnInputKeyDown"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"
                             Padding="12,10,40,10"/>

                    <!-- Visibility Toggle Button -->
                    <Button Command="{Binding TogglePasswordVisibilityCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Width="28" Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Toggle password visibility">
                        <TextBlock Text="👁" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- Login Action Button -->
                <Button Content="Sign In"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        Height="44"
                        FontSize="15"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}"/>

                <!-- Loading Indicator -->
                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             Foreground="{StaticResource ActionBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,12,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
