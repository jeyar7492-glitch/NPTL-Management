<UserControl x:Class="NPTELManagement.Desktop.Views.StudentNotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:NPTELManagement.Desktop.Common"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="{StaticResource BackgroundBrush}"
             Loaded="StudentNotificationsView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            
            <!-- Page Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ACADEMIC NOTIFICATIONS"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource SecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Department &amp; NPTEL Announcements"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Important alerts regarding assignment releases, hall ticket schedules, and verification progress."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="↻ Refresh Notifications"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Foreground="{StaticResource ActionBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,0,16"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- Error Banner -->
            <Border Background="{StaticResource DangerLightBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="0,0,0,20"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Error Loading Notifications"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="14"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Retry"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshCommand}"
                            Padding="14,6"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Empty State -->
            <Border Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="48,36"
                    Margin="0,20,0,0"
                    Visibility="{Binding HasNoNotifications, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔔"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="No notifications available."
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="You have no unread circulars or system messages at this time."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Notifications List -->
            <ItemsControl ItemsSource="{Binding Notifications}"
                          Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Content -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <!-- Read / Unread Status Badge -->
                                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="● NEW"/>
                                                        <Setter Property="Foreground" Value="{StaticResource ActionBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter Property="Text" Value="READ"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Date -->
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Title -->
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,0,4"/>

                                    <!-- Message -->
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Right: Mark as Read Action -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Mark as Read ✓"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsRead, Converter={StaticResource InvBoolToVis}}"
                                            Padding="12,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
