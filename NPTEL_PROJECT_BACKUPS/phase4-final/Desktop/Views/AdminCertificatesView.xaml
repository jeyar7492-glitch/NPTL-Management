<UserControl x:Class="NPTELManagement.Desktop.Views.AdminCertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:NPTELManagement.Desktop.Common"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Actions -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ADMINISTRATION MODULE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Certificate Verification Queue &amp; Cloud Storage" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='Total Certificates in Registry: {0}'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↑ Upload PDF" Style="{StaticResource PrimaryButton}" Command="{Binding UploadCertificateCommand}" Margin="0,0,8,0" Padding="14,8"/>
                    <Button Content="✓ Verify Credit" Style="{StaticResource SecondaryButton}" Command="{Binding VerifyCertificateCommand}" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Content="🔗 View (Signed URL)" Style="{StaticResource SecondaryButton}" Command="{Binding ViewSignedUrlCommand}" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Padding="12,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Filters & Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="16,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Search (Student / Reg No / Course)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Verification Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Width="130" Style="{StaticResource FormComboBox}">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Verified"/>
                        <ComboBoxItem Content="Rejected"/>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 3. Certificates DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Certificates}"
                          SelectedItem="{Binding SelectedCertificate}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="White"
                          RowHeight="42"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reg No" Binding="{Binding RegisterNumber}" Width="120" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="160"/>
                        <DataGridTextColumn Header="Course Code" Binding="{Binding CourseCode}" Width="110"/>
                        <DataGridTextColumn Header="Course Name" Binding="{Binding CourseName}" Width="*"/>
                        <DataGridTemplateColumn Header="Cloud File" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                            Background="{Binding HasFile, Converter={StaticResource BoolToVis}, ConverterParameter='file'}">
                                        <TextBlock Text="{Binding HasFile, StringFormat='Uploaded'}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Verified Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                            Background="{Binding VerifiedStatus, Converter={StaticResource TimelineStatusToBrushConverter}}">
                                        <TextBlock Text="{Binding VerifiedStatus}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedDate, StringFormat='dd MMM yyyy'}" Width="110"/>
                        <DataGridTextColumn Header="Verified Date" Binding="{Binding VerifiedDate, StringFormat='dd MMM yyyy'}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Background="#66FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Loading certificates..." HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Status Bar -->
        <StackPanel Grid.Row="3" Margin="4,12,4,0" Orientation="Horizontal">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        </StackPanel>

    </Grid>
</UserControl>
