<UserControl x:Class="NPTELManagement.Desktop.Views.StudentCoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:NPTELManagement.Desktop.Common"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="{StaticResource BackgroundBrush}"
             Loaded="StudentCoursesView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            
            <!-- Page Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MY NPTEL COURSES"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource SecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Enrolled SWAYAM / NPTEL Courses"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Track your ongoing courses, milestone timelines, examination dates, and certificates."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="↻ Refresh Courses"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Foreground="{StaticResource ActionBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,0,16"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- Error Banner -->
            <Border Background="{StaticResource DangerLightBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="0,0,0,20"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Load Error"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="14"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Retry"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshCommand}"
                            Padding="14,6"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Empty State -->
            <Border Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="48,36"
                    Margin="0,20,0,0"
                    Visibility="{Binding HasNoCourses, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📚"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="No NPTEL courses registered."
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="You have not enrolled in any NPTEL courses yet or registrations have not been linked."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Course Cards List -->
            <ItemsControl ItemsSource="{Binding Courses}"
                          Visibility="{Binding HasCourses, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Course Details -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding CourseCode}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ActionBrush}"/>
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DurationWeeks, StringFormat='{}{0} Weeks'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding RegistrationStatus}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding CourseName}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,0,8"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                            <TextBlock Text="Start Date" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CourseStartDate, StringFormat='{}{0:dd MMM yyyy}', TargetNullValue='TBA'}" 
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,32,0">
                                            <TextBlock Text="End Date" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CourseEndDate, StringFormat='{}{0:dd MMM yyyy}', TargetNullValue='TBA'}" 
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Enrolled On" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding EnrollmentDate, StringFormat='{}{0:dd MMM yyyy}'}" 
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Right: View Details Action -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="View Course Details →"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="16,10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
