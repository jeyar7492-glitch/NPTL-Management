                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary & Brand Colors -->
    <Color x:Key="PrimaryColor">#0D233A</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>

    <Color x:Key="SecondaryColor">#1E3A8A</Color>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>

    <Color x:Key="ActionColor">#2563EB</Color>
    <SolidColorBrush x:Key="ActionBrush" Color="{StaticResource ActionColor}"/>

    <Color x:Key="ActionHoverColor">#1D4ED8</Color>
    <SolidColorBrush x:Key="ActionHoverBrush" Color="{StaticResource ActionHoverColor}"/>

    <!-- Neutrals & Backgrounds -->
    <Color x:Key="BackgroundColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>

    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>                                                                                               

    <Color x:Key="SurfaceHoverColor">#F1F5F9</Color>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>

    <Color x:Key="BorderColor">#E2E8F0</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <Color x:Key="BorderFocusColor">#2563EB</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

    <!-- Typography Colors -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>

    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <Color x:Key="TextWhiteColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextWhiteBrush" Color="{StaticResource TextWhiteColor}"/>

    <!-- Status & Feedback -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#DCFCE7"/>

    <Color x:Key="WarningColor">#D97706</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF3C7"/>

    <Color x:Key="DangerColor">#DC2626</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEE2E2"/>

</ResourceDictionary>
