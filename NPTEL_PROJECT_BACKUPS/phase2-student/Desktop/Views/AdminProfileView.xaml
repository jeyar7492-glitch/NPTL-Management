<UserControl x:Class="NPTELManagement.Desktop.Views.AdminProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="800" HorizontalAlignment="Left">
            
            <TextBlock Text="ADMINISTRATOR PROFILE"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource SecondaryBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="System Governance Account"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,0,24"/>

            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Foreground="{StaticResource ActionBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,0,16"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Account Details"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Admin Identifier" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding AdminData.AdminIdentifier}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Role Scope" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Full System Administrator" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Department Scope" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Institution-Wide (All Departments)" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Database Entity ID"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AdminData.AdminId}"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"/>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
