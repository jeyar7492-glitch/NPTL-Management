<UserControl x:Class="NPTELManagement.Desktop.Views.StaffDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:NPTELManagement.Desktop.Common"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Staff Assignment Summary -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="STAFF PORTAL &amp; MENTOR MONITORING"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource SecondaryBrush}"
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="{Binding StaffDisplayName, StringFormat='Staff: {0}'}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal">
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                            <TextBlock Text="{Binding StaffDisplayId, StringFormat='ID: {0}'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>

                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                            <TextBlock Text="{Binding StaffDisplayDepartment, StringFormat='Dept: {0}'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>

                        <Border Background="#DBEAFE" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding StaffDisplayAssignedScope, StringFormat='Scope: {0}'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ActionBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="↻ Refresh List"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 2. Loading & Error States -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="4"
                     Foreground="{StaticResource ActionBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,0,0,12"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="1"
                Background="{StaticResource DangerLightBrush}"
                BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,16"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Retry" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- 3. Search & Filter Bar -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search student name, register number, or class section"
                         Margin="0,0,12,0"/>

                <!-- Year Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding AvailableYears}"
                              SelectedItem="{Binding SelectedYearFilter, Mode=TwoWay}"
                              Width="100" Height="36"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Class Filter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Class:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding AvailableClasses}"
                              SelectedItem="{Binding SelectedClassFilter, Mode=TwoWay}"
                              Width="90" Height="36"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Reset Button -->
                <Button Grid.Column="3"
                        Content="Reset Filters"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearSearchCommand}"
                        Height="36"
                        Padding="12,0"
                        Margin="0,0,12,0"/>

                <!-- Count Badge -->
                <TextBlock Grid.Column="4"
                           Text="{Binding StudentCount, StringFormat='Showing {0} student(s)'}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 4. Read-Only DataGrid & Empty State -->
        <Grid Grid.Row="3">
            
            <!-- DataGrid -->
            <DataGrid Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding FilteredStudents}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Student Name" Binding="{Binding Name}" Width="1.5*"/>
                    <DataGridTextColumn Header="Register No" Binding="{Binding RegisterNumber}" Width="1.2*"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="*"/>
                    <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="0.6*"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassSection}" Width="0.8*"/>
                    <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.8*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="1.1*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty State Overlay -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40"
                    Visibility="{Binding HasNoStudents, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="No students are currently available."
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="No assigned students found matching your search and filter criteria."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>

    </Grid>
</UserControl>
