# ============================================================================
# NPTEL Management System - Production Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION PASSWORDS, TOKENS, OR SECRETS TO REPOSITORY
# Copy this file to .env or set these in your server environment / secret manager.
# ============================================================================

# Environment Mode: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production

# Server URL & Port Binding (e.g., container default port 8080 or port 443 with TLS)
ASPNETCORE_URLS=http://+:8080

# Primary Supabase PostgreSQL Database Connection String (Mandatory in Production)
# Example: Host=db.your-project.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_SECURE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
SUPABASE_DB_CONNECTION=

# JWT Symmetric Signing Secret (Mandatory in Production; minimum 32 characters; prefer 64+ random characters)
JWT_SECRET=

# Optional JWT Issuer and Audience Validation Settings
JWT_ISSUER=NPTELManagementApi
JWT_AUDIENCE=NPTELManagementClient

# Supabase Project Base URL (Mandatory for Private Storage)
# Example: https://your-project.supabase.co
SUPABASE_URL=

# Supabase Modern Secret API Key (sb_secret_...) - Injected via apikey header
SUPABASE_SERVICE_KEY=

# Supabase Legacy Storage Service Role JWT (eyJ...) - Required for Storage REST Authorization Bearer
SUPABASE_STORAGE_SERVICE_ROLE_KEY=

# Desktop Client Endpoint Override (Optional: used by Desktop client or test runners)
# Example: https://api.nptel.jpcollege.ac.in
NPTEL_API_URL=

# Background Automation Worker Feature Flag
# Set to 'true' for persistent servers (Render/local). Set to 'false' for stateless/serverless containers (Vercel).
ENABLE_BACKGROUND_WORKER=true

