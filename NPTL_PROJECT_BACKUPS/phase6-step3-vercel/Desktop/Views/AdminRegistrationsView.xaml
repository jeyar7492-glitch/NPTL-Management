<UserControl x:Class="NPTELManagement.Desktop.Views.AdminRegistrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:NPTELManagement.Desktop.Common"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Actions -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ADMINISTRATION MODULE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="NPTEL Course Enrollments &amp; Exam Governance" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='Total Course Registrations: {0}'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Enroll Student" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCreateDialogCommand}" Margin="0,0,8,0" Padding="14,8"/>
                    <Button Content="📝 Manage Exam" Style="{StaticResource SecondaryButton}" Command="{Binding OpenExamDialogCommand}" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Content="🔄 Advance Status" Style="{StaticResource SecondaryButton}" Command="{Binding UpdateStatusCommand}" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Padding="12,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Filters & Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="16,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Search (Student / Reg No / Course)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Registration Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Width="130" Style="{StaticResource FormComboBox}">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Registered"/>
                        <ComboBoxItem Content="InProgress"/>
                        <ComboBoxItem Content="Completed"/>
                        <ComboBoxItem Content="Dropped"/>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 3. Registrations DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Registrations}"
                          SelectedItem="{Binding SelectedRegistration}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="White"
                          RowHeight="42"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reg No" Binding="{Binding RegisterNumber}" Width="120" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="160"/>
                        <DataGridTextColumn Header="Class / Sec" Binding="{Binding ClassSection, StringFormat='Year {0}'}" Width="90"/>
                        <DataGridTextColumn Header="Course Code" Binding="{Binding CourseCode}" Width="110"/>
                        <DataGridTextColumn Header="Course Name" Binding="{Binding CourseName}" Width="*"/>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource TimelineStatusToBrushConverter}}">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Exam Status" Binding="{Binding ExamApplicationStatus}" Width="110"/>
                        <DataGridTextColumn Header="Cert Status" Binding="{Binding CertificateStatus}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Background="#66FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Loading registrations..." HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Status Bar -->
        <StackPanel Grid.Row="3" Margin="4,12,4,0" Orientation="Horizontal">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Enroll Student Modal Overlay -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardStyle}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Enroll Student in NPTEL Course" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Student Register Number" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewStudentRegisterNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="Select Course" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableCourses}"
                              SelectedItem="{Binding SelectedNewCourse}"
                              DisplayMemberPath="CourseName"
                              Style="{StaticResource FormComboBox}"
                              Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCreateCommand}" Margin="0,0,8,0" Padding="16,8"/>
                        <Button Content="Confirm Enrollment" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCreateCommand}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Manage Exam Modal Overlay -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsExamDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardStyle}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Update Examination Details" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EditingStudentInfo}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding EditingCourseInfo}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Application Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding EditExam.ExamApplicationStatus, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource FormComboBox}">
                                <ComboBoxItem Content="NotStarted"/>
                                <ComboBoxItem Content="Applied"/>
                                <ComboBoxItem Content="FeePaid"/>
                                <ComboBoxItem Content="HallTicketIssued"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Exam Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding EditExam.ExamStatus, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource FormComboBox}">
                                <ComboBoxItem Content="NotStarted"/>
                                <ComboBoxItem Content="Scheduled"/>
                                <ComboBoxItem Content="Completed"/>
                                <ComboBoxItem Content="Absent"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Exam Date" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding EditExam.ExamDate}" Style="{StaticResource FormDatePicker}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Application Deadline" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding EditExam.ExamApplicationDeadline}" Style="{StaticResource FormDatePicker}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Score (0 - 100)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditExam.Score, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pass Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding EditExam.PassStatus, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource FormComboBox}">
                                <ComboBoxItem Content="Passed"/>
                                <ComboBoxItem Content="Elite"/>
                                <ComboBoxItem Content="Elite+Gold"/>
                                <ComboBoxItem Content="Elite+Silver"/>
                                <ComboBoxItem Content="Failed"/>
                                <ComboBoxItem Content="Absent"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelExamCommand}" Margin="0,0,8,0" Padding="16,8"/>
                        <Button Content="Save Exam Record" Style="{StaticResource PrimaryButton}" Command="{Binding SaveExamCommand}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
